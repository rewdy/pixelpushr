{
  "name": "@pixelpushr/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/local.ts",
    "build": "bun build src/lambda.ts src/migrateLambda.ts src/cleanupLambda.ts --outdir dist --target node",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "storage:init": "bun src/media/initFloci.ts",
    "media:cleanup": "bun src/media/cleanupLocal.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.883.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/client-sesv2": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@hono/node-server": "^1.19.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@pixelpushr/contracts": "workspace:*",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.6",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.6",
    "postgres": "^3.4.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/nodemailer": "^7.0.1",
    "drizzle-kit": "^0.31.5"
  }
}
